resource app_signature "application/x-vnd.sen-labs.ReferenceNavigator";

resource app_flags B_MULTIPLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	/* 0 = development	1 = alpha			2 = beta
	   3 = gamma		4 = golden master	5 = final */
	variety = 0,

	internal = 0,

	short_info = "SENSEI Reference Navigator",
	long_info  = "SEN module to open the targets of references: what they point to decides how (a MIME type, its attribute, any other file)."
};

/* declare as a SEN plugin so it will be detected and used accordingly. */
resource(0, "META:TYPE") "application/x-vnd.sen-labs.plugin";

// set supported feature flags
resource(1, "SEN:plugin:extract")  0;
resource(2, "SEN:plugin:enrich")   0;
resource(3, "SEN:plugin:identify") 0;
resource(4, "SEN:plugin:navigate") 1;

/* generic references, what a type contains (its attributes) and the attributes themselves */
resource file_types message {
    "types" = "relation/x-vnd.sen-labs.relation.reference",
    "types" = "relation/x-vnd.sen-labs.relation.dependency",
    "types" = "relation/x-vnd.sen-labs.relation.contains",
    "types" = "meta/x-vnd.sen-labs.meta-mime-attribute"
};
