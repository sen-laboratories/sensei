resource app_signature "application/x-vnd.sen-labs.MimeExtractor";

resource app_flags B_MULTIPLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 0,
	middle = 0,
	minor  = 1,

	/* 0 = development	1 = alpha			2 = beta
	   3 = gamma		4 = golden master	5 = final */
	variety = 0,

	internal = 0,

	short_info = "SEN MIME Extractor",
	long_info  = "SEN module to extract the attributes of a MIME type as its contents."
};

/* declare as a SEN plugin so it will be detected and used accordingly. */
resource(0, "META:TYPE") "application/x-vnd.sen-labs.plugin";

// set supported feature flags
resource(1, "SEN:plugin:extract")  1;
resource(2, "SEN:plugin:enrich")   0;
resource(3, "SEN:plugin:identify") 0;
resource(4, "SEN:plugin:navigate") 0;

/* the files that it scans: the entries of the MIME database */
resource file_types message {
    "types" = "application/x-vnd.Be-meta-mime"
};

/* the type that is contained in a type: the contents are the attributes, which are of their own type (see each item) */
resource(5, "SEN:typeMapping") message {
    "SEN:default" = "relation/x-vnd.sen-labs.relation.contains"
};

/* names of the properties in the result */
resource(6, "SEN:attrMapping") message {
    "_type"      = "SEN:relationType",
    "name"       = "SEN:attr:name",
    "type"       = "SEN:attr:type",
    "viewable"   = "SEN:attr:viewable",
    "editable"   = "SEN:attr:editable",
    "searchable" = "SEN:attr:searchable",
    "width"      = "SEN:attr:width"
};
