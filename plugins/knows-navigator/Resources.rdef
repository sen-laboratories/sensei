resource app_signature "application/x-vnd.sen-plugin.sen-labs.knows-navigator";

resource app_flags B_MULTIPLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	/* 0 = development	1 = alpha			2 = beta
	   3 = gamma		4 = golden master	5 = final */
	variety = 2,

	internal = 4,

	short_info = "SENSEI Knows Navigator",
	long_info  = "SEN module to open the person or organization that a relationship between people ends at (knows, friend, colleague, employment...) with its application."
};

/* declare as a SEN plugin so it will be detected and used accordingly. */
resource(0, "META:TYPE") "application/x-vnd.sen-labs.plugin";

// set supported feature flags
resource(1, "SEN:plugin:extract")  0;
resource(2, "SEN:plugin:enrich")   0;
resource(3, "SEN:plugin:identify") 0;
resource(4, "SEN:plugin:navigate") 1;

/* the relationship between people (Knows and its special cases) and from a person to an organization */
resource file_types message {
    "types" = "relation/x-vnd.sen-labs.relation.person.knows",
    "types" = "relation/x-vnd.sen-labs.relation.person.acquaintance",
    "types" = "relation/x-vnd.sen-labs.relation.person.friend",
    "types" = "relation/x-vnd.sen-labs.relation.person.close-friend",
    "types" = "relation/x-vnd.sen-labs.relation.person.partner",
    "types" = "relation/x-vnd.sen-labs.relation.person.parent",
    "types" = "relation/x-vnd.sen-labs.relation.person.sibling",
    "types" = "relation/x-vnd.sen-labs.relation.person.relative",
    "types" = "relation/x-vnd.sen-labs.relation.person.colleague",
    "types" = "relation/x-vnd.sen-labs.relation.person.superior",
    "types" = "relation/x-vnd.sen-labs.relation.person.mentor",
    "types" = "relation/x-vnd.sen-labs.relation.person.collaborator",
    "types" = "relation/x-vnd.sen-labs.relation.person.client",
    "types" = "relation/x-vnd.sen-labs.relation.person.employment",
    "types" = "relation/x-vnd.sen-labs.relation.person.membership"
};
