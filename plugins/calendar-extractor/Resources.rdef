resource app_signature "application/x-vnd.sen-plugin.sen-labs.calendar-extractor";

resource app_flags B_MULTIPLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	/* 0 = development	1 = alpha			2 = beta
	   3 = gamma		4 = golden master	5 = final */
	variety = 2,

	internal = 1,

	short_info = "SEN Calendar Extractor",
	long_info  = "Reads calendar files (iCalendar and vCalendar): an invitation or a calendar entry becomes an event with its time, place, link to the meeting and description, named after the event; its attendees, its place and the instances of its series are the relations of the event."
};

/* declare as a SEN plugin so it will be detected and used accordingly. */
resource(0, "META:TYPE") "application/x-vnd.sen-labs.plugin";

// set supported feature flags
resource(1, "SEN:plugin:extract")  0;
resource(2, "SEN:plugin:enrich")   1;
resource(3, "SEN:plugin:identify") 1;
resource(4, "SEN:plugin:navigate") 1;
// whether the settings window of SEN has anything to show for this plugin (a plugin that says false is not listed there)
resource(20, "SEN:plugin:hasSettings") false;

/* what it handles: the calendar files (to identify and to enrich), the events, and the relation types that it works out (the server asks the plugin that names a dynamic relation type here) */
resource file_types message {
    "types" = "text/calendar",
    "types" = "text/x-vcalendar",
    "types" = "entity/x-vnd.sen-labs.entity.event",
    "types" = "relation/x-vnd.sen-labs.relation.event.attendee",
    "types" = "relation/x-vnd.sen-labs.relation.event.location",
    "types" = "relation/x-vnd.sen-labs.relation.event.series"
};

