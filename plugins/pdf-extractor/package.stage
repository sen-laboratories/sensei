#!/bin/sh
# SPDX-License-Identifier: MIT
# SPDX-FileCopyrightText: 2026 SEN Labs e.U.
#
# Adds libqpdf to the package: it is not in HaikuPorts, so the plugin brings the library (lib/qpdf, qpdf 12.3.0) itself.
# (If HaikuPorts or the Kiri repository get a qpdf package, remove this and require lib:libqpdf instead.)
set -e
stage=$1
here=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$stage/lib" "$stage/documentation/packages/sen_plugin_pdf_extractor"
cp -a "$here/lib/qpdf/libqpdf.so.30.3.0" "$stage/lib/"
ln -s libqpdf.so.30.3.0 "$stage/lib/libqpdf.so.30"
cat > "$stage/documentation/packages/sen_plugin_pdf_extractor/NOTICE-qpdf" <<'NOTICE'
This package contains the library libqpdf 12.3.0 (https://github.com/qpdf/qpdf), (c) Jay Berkenbilt and the qpdf contributors,
licensed under the Apache License, version 2.0 (https://www.apache.org/licenses/LICENSE-2.0).
NOTICE
