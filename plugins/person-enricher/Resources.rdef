resource app_signature "application/x-vnd.sen-plugin.sen-labs.person-enricher";

resource app_flags B_MULTIPLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	/* 0 = development	1 = alpha			2 = beta
	   3 = gamma		4 = golden master	5 = final */
	variety = 2,

	internal = 7,

	short_info = "SEN Robin (Person Enricher)",
	long_info  = "Robin - Enriching People: finds the public photo, the profile, the verified links and the posts of a person from what the file links to: Libravatar and Gravatar (by the hash of the e-mail address), GitHub, the Fediverse, Bluesky and the feed of a homepage. A person that has only a name or a handle is searched for on Bluesky, the Fediverse, GitHub, Wikidata and ORCID: a clear match is taken, else you choose (several matches can be merged). Which services may be asked is set in the settings of SEN."
};

/* declare as a SEN plugin so it will be detected and used accordingly. */
resource(0, "META:TYPE") "application/x-vnd.sen-labs.plugin";

// set supported feature flags
resource(1, "SEN:plugin:extract")  0;
resource(2, "SEN:plugin:enrich")   1;
resource(3, "SEN:plugin:identify") 0;
resource(4, "SEN:plugin:navigate") 0;
// whether the settings window of SEN has anything to show for this plugin
resource(20, "SEN:plugin:hasSettings") true;

/* defines supported file types: a person entity and a Haiku People person */
resource file_types message {
    "types" = "entity/x-vnd.sen-labs.entity.person",
    "types" = "application/x-person"
};

